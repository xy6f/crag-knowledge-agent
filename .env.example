# ============ 大模型 ============
# DeepSeek 开放平台 API Key（https://platform.deepseek.com 注册获取）
DEEPSEEK_API_KEY=
# OpenAI 兼容接口地址
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 对话模型
DEEPSEEK_MODEL=deepseek-chat

# ============ Embedding ============
# 推荐：先运行 scripts/download_model.py 把模型下到 models/，然后指向本地路径
EMBEDDING_MODEL=E:\software\agentic-rag\models\bge-small-zh-v1.5
# 备用：改为模型名则在线下载（国内建议保留镜像端点）
# EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
HF_ENDPOINT=https://hf-mirror.com
